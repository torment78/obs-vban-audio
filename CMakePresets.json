{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 — Visual Studio 2026",
      "description": "MSVC v145, Windows SDK 10.0.26100.0, native OBS VBAN plugin",
      "binaryDir": "${sourceDir}/build_x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v145",
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true,
        "BUILD_TESTING": true,
        "CMAKE_COMPILE_WARNING_AS_ERROR": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
